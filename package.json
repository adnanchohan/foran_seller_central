{
  "name": "foran-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm contract:lint && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "contract:lint": "redocly lint packages/contracts/openapi/v1.yaml --format=stylish",
    "db:generate": "pnpm --filter @foran/db db:generate",
    "db:migrate:local": "pnpm --filter @foran/api-worker db:migrate:local",
    "dev:api": "pnpm --filter @foran/api-worker dev",
    "dev:user": "pnpm --filter @foran/user-dashboard dev",
    "dev:admin": "pnpm --filter @foran/admin-dashboard dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.70.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
