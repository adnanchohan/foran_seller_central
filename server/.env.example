NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/foran_seller_central

# Firebase Admin service-account values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Provider-only authentication. Add apple.com later when Apple is configured.
ALLOWED_AUTH_PROVIDERS=google.com

# Comma-separated Google accounts that can access the admin portal.
ADMIN_EMAILS=

# Development-only private upload directory.
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_MB=10
