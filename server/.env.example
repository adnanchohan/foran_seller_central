NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
# Only the Firebase project ID is needed for server-side ID-token verification.
FIREBASE_PROJECT_ID=

# Provider-only authentication. Add apple.com later when Apple is configured.
ALLOWED_AUTH_PROVIDERS=google.com

# Comma-separated Google accounts that can access the admin portal.
ADMIN_EMAILS=

MAX_UPLOAD_MB=10
