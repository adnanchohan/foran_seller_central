# Cloudflare Environment & Worker Configuration
NODE_ENV=development
LOG_LEVEL=info

# Gateway & CORS Configuration
DASHBOARD_ORIGINS=http://localhost:5173,http://localhost:5174
USER_PAGES_ORIGIN=http://localhost:5173
ADMIN_PAGES_ORIGIN=http://localhost:5174

# Authentication & Security
# Dual Google OAuth Client IDs for Portal Isolation
VITE_GOOGLE_SELLER_CLIENT_ID=your-seller-platform-client-id.apps.googleusercontent.com
VITE_GOOGLE_ADMIN_CLIENT_ID=your-admin-dashboard-client-id.apps.googleusercontent.com
GOOGLE_SELLER_CLIENT_ID=your-seller-platform-client-id.apps.googleusercontent.com
GOOGLE_ADMIN_CLIENT_ID=your-admin-dashboard-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ADMIN_GOOGLE_SUBS=google-sub-id-admin-1,google-sub-id-admin-2
ADMIN_EMAILS=admin@foran.pk,founder@foran.pk
SESSION_TTL_SECONDS=3600
ALLOWED_AUTH_PROVIDERS=google.com

# Upload & Storage
MAX_UPLOAD_MB=10

